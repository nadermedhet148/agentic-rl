# Copy this file to `.env` and fill in what you need. `.env` is gitignored —
# never commit real keys. Loaded automatically by `create_app()` (api/app.py,
# via python-dotenv) whenever the app starts, including through run.bat — no
# need to `export` these yourself. Unset values fall back to the defaults
# shown below (see core/config.py for the full list).

# --- LLM provider keys — the system is model-agnostic (see llm/providers.py and
# docs/ARCHITECTURE.md "LLM calls"); AGENTIC_RL_PLANNER below picks which one is
# actually used, so you only need to fill in the key for that one. Not needed at
# all with AGENTIC_RL_PLANNER=mock.
#
# Claude: get a key at https://console.anthropic.com/ — or run `ant auth login`
# and leave this unset instead; this project always constructs its own
# anthropic.AsyncAnthropic() client, so the usual ANTHROPIC_API_KEY / `ant auth
# login` credential-chain resolution applies unchanged. Unlike OpenAI/Google
# below, an LLMPlanner/LLMDistiller with provider="claude" does NOT fail at
# construction just because this is unset (it's resolved lazily, at request
# time) — see llm/providers.py's module docstring for why that's provider-
# specific, verified behavior, not an oversight.
ANTHROPIC_API_KEY=
# OpenAI: get a key at https://platform.openai.com/api-keys. Required as soon as
# AGENTIC_RL_PLANNER=openai — the raw OpenAI SDK checks this eagerly, so a
# missing key fails at app startup, not on first request.
OPENAI_API_KEY=
# Google: get a key at https://ai.google.dev/gemini-api/docs/api-key (the legacy
# GEMINI_API_KEY name also still works). Required as soon as
# AGENTIC_RL_PLANNER=google, same eager-startup-failure behavior as OpenAI above.
GOOGLE_API_KEY=
# Suppresses PydanticAI's ASCII-art startup banner in logs. The app already sets
# this for you (llm/llm_planner.py, llm/distiller.py) — uncomment only if you're
# running something else against this venv that imports pydantic_ai directly.
# PYDANTIC_AI_NO_BANNER=1

# --- agentic-rl settings (core/config.py — all optional, shown with defaults) -
# sim | dev | prod_strict — see docs/PLAN.md "Runtime modes"
AGENTIC_RL_MODE=dev
# claude | openai | google | mock — selects the LLM provider (llm/providers.py)
# for both the planner and the distiller. mock needs no API key and uses a small
# URL/scheduling heuristic (see llm/mock.py:heuristic_default_fn) so the UI is
# still testable without one.
AGENTIC_RL_PLANNER=claude
# linucb | epsilon | greedy
AGENTIC_RL_POLICY=linucb
# Must be a model id from whichever provider AGENTIC_RL_PLANNER selects — e.g.
# claude-opus-5 / gpt-5.1 / gemini-3-pro (check each provider's own docs for
# their current model list; llm/providers.py only sanity-checks the id's prefix
# against the provider, it doesn't validate the model actually exists).
AGENTIC_RL_LLM_MODEL=claude-opus-5
AGENTIC_RL_DB_PATH=agentic_rl.db
AGENTIC_RL_HTTP_TIMEOUT_S=15.0
AGENTIC_RL_HTTP_MAX_BODY_BYTES=256000
AGENTIC_RL_CORRECTIONS_TOP_K=5

# --- Langfuse tracing (optional, off by default — see docs/OBSERVABILITY.md) -
# Requires: pip install -e ".[observability]"
AGENTIC_RL_OBSERVABILITY_ENABLED=false
# Fill these in once you have a Langfuse project URL, then flip the line above
# to true. Read directly by the langfuse SDK, not by this project's own config.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Must be the capitalized string False (not false) to actually disable tracing
# at the SDK level — a known upstream quirk. Leave unset unless you hit it.
# LANGFUSE_TRACING_ENABLED=False
